# Copy this file to `.env` before running the backend locally.

# Trained CNN checkpoint used by `main.py`
MODEL_PATH=./model/chilliscan_cnn.pth

# Optional metadata file generated by `train_model.py`
CLASS_NAMES_PATH=./model/class_names.json

# Dataset root used for training and as a metadata fallback during local dev
DATASET_DIR=../Dataset

# Frontend origins allowed to call the FastAPI API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Maximum accepted upload size in megabytes
MAX_UPLOAD_MB=10

