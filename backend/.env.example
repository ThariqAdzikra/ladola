# ChilliGuard Backend — Environment Variables
# Copy this file to .env and fill in the values

# Model path (once you have a trained CNN)
MODEL_PATH=./model/chilli_cnn.h5

# Optional: Gemini API key (if backend proxies LLM calls)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3000
